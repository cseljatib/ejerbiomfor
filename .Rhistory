q()
library(datana)
data(idahohd2)
df <- idahohd2
head(df)
dim(df)
str(df)
summary(df$atot)
summary(df[,c("atot","dap")])
descstat(df[,c("atot","dap")])
boxplot(df$atot)
hist(df$atot)
boxplot(df$dap)
hist(df$dap)
plot(atot ~ dap, data=df)
poder.nls <- nls(atot~  b0*dap^(b1),
data = df,
start = list(b0 = 7, b1=0.5),trace=T)
summary(poder.nls)
(summary(poder.nls))$sigma
sigma.e<-(summary(poder.nls))$sigma
sigma.e
summary(poder.nls)
coef(poder.nls)
confint(poder.nls, level=0.95)
coef(poder.nls)
coef(poder.nls)[1]
b0.hat<-coef(poder.nls)[1]
b1.hat<-coef(poder.nls)[2]
b0.hat
b1.hat
range(df$dap)
d.fake <- seq(10,122,by=0.1)
range(df$dap)
d.ast <- seq(10,122,by=0.1)
d.ast <- seq(10,122,by=0.1);d.ast
yhat<-predict(poder.nls, newdata=data.frame(dap=d.ast))
plot(atot~dap, data=df)
lines(d.fake, yhat, col="red",lwd=2)
b0.hat
b1.hat
sigma.e
var.e<-sigma.e;var.e
sigma.e
var.e<-sigma.e^2;var.e
m2<-lm(I(log(atot))~I(log(dap)),data=df)
summary(m2)
sigma.e.2<-summary(m2)$sigma
sigma.e.2^2
var.e.2<-sigma.e.2^2
summary(poder.nls)
df$y.nls<-predict(poder.nls,newdata = df)
predstat(obs=df$atot,pre=df$y.nls)
df$y.ln<- exp(fitted(m2))
predstat(obs=df$atot,pre=df$y.ln)
predstat(obs=df$atot,pre=df$y.ln,want.percent = T)
predstat(obs=df$atot,pre=df$y.nls,want.percent = T)
var.e.2
df$y.ln.corre<- exp(fitted(m2)*(var.e.2/2))
predstat(obs=df$atot,pre=df$y.ln.corre,want.percent = T)
coef(m2)
b0.hat2<-coef(m2)
b1.hat2<-coef(m2)[2]
b0.hat2<-coef(m2)[1]
df$y.ln<- exp(b0.hat2+b1.hat2*log(df$dap))
predstat(obs=df$atot,pre=df$y.ln,want.percent = T)
b0.hat2.corre<-(coef(m2)[1] + (var.e.2/2))
b0.hat2.corre
df$y.ln.corre<- exp(b0.hat2.corre+b1.hat2*log(df$dap))
predstat(obs=df$atot,pre=df$y.ln.corre,want.percent = T)
predstat(obs=df$atot,pre=df$y.nls,want.percent = T)
q()
